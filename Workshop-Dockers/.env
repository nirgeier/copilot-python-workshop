# Docker Environment Variables
# Base image and version
BASE_IMAGE=ubuntu:22.04
NODE_VERSION=20

# Application configuration
APP_DIR=/usr/src/app
REPO_BRANCH=Docker
#REPO_URL=https://github.com/commit-ai/copilot-python-workshop.git
REPO_URL=https://github.com/nirgeier/copilot-python-workshop.git

# Container labels
CONTAINER_NAME=copilot-python-workshop
VERSION=1.0
DESCRIPTION="Dockerfile for Python Workshop"

# Port configuration
BACKEND_PORT=3000
FRONTEND_PORT=4200

# Working directories
SRC_DIR=/app/src
WORKSHOP_DIR=/app/copilot-python-workshop/frontend
WORKSHOP_SRC=../copilot-python-workshop

